# Copy to .env.local and fill in. See README.md, section 8.

# The site's real address. Used for canonical links, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project: Project Settings -> API. For the local database, `npx supabase status` in backend/ prints them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: only the server uses it (payments, staff invitations). Never commit it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Demo only: shows a control on the payment step to force a failed payment. Set to false for production.
NEXT_PUBLIC_SHOW_MOCK_CONTROLS=true
